EFFECT_BROWSER_DATABASE_URL=sqlite:///./effect-browser.db
EFFECT_BROWSER_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
EFFECT_BROWSER_PROVIDER=auto
EFFECT_BROWSER_OPENAI_MODEL=gpt-5.6
EFFECT_BROWSER_GROK_MODEL=grok-4.5
EFFECT_BROWSER_MISSION_MAX_PARALLEL_RESEARCH=4
EFFECT_BROWSER_SESSION_STATE_MAX_BYTES=2097152
EFFECT_BROWSER_SESSION_RETENTION_HOURS=168
# Windows uses per-user DPAPI by default. Elsewhere, set a URL-safe-base64 32-byte key.
# EFFECT_BROWSER_SESSION_ENCRYPTION_KEY=
# EFFECT_BROWSER_DEFAULT_PROFILE_ID=
# EFFECT_BROWSER_DEFAULT_DOCUMENT_PATH=C:\approved\resume.pdf
# EFFECT_BROWSER_BROWSER_SANDBOX=true
# OPENAI_API_KEY=
# XAI_API_KEY=
# EFFECT_BROWSER_BROWSER_EXECUTABLE=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
